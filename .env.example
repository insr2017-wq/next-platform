# Obrigatório. Sem isso o app não inicia.
JWT_SECRET=

# Só para `npm run db:seed` (criação da conta admin). Não sobrescreve senha existente.
ADMIN_SEED_PASSWORD=

# URL pública canônica (links de convite e callbacks). Sem www.
# www.xbot0.xyz redireciona para xbot0.xyz no middleware; CORS aceita os dois.
NEXT_PUBLIC_APP_URL=https://xbot0.xyz
APP_URL=https://xbot0.xyz
NEXT_PUBLIC_BASE_URL=https://xbot0.xyz

# Gateways de pagamento
# MISTICPAY_CLIENT_SECRET deve existir só em variável de ambiente — nunca commitar o valor real.
MISTICPAY_CLIENT_ID=pk_...
MISTICPAY_CLIENT_SECRET=sk_...
MISTICPAY_WEBHOOK_URL=https://xbot0.xyz/webhooks/misticpay
DEFAULT_ACTIVE_GATEWAY=vizzion_pay
